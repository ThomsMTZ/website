# Google Tag Manager
NEXT_PUBLIC_GTM=GTM-XXXXXXX

# App URL (used for metadata)
NEXT_PUBLIC_APP_URL=https://thomsmtz.dev

# Recipient email for contact form messages
EMAIL_ADDRESS=your-email@example.com

# Telegram Bot (used for contact form notifications)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Optional: SMTP email configuration (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
